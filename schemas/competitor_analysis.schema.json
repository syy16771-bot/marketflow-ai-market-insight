{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketflow.local/schemas/competitor_analysis.schema.json",
  "title": "MarketFlow AI Competitor Analysis",
  "description": "竞品矩阵、确定性价格区间及 AI 差异洞察。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_id",
    "price_range",
    "competitor_matrix",
    "strengths",
    "weaknesses",
    "differentiation_opportunities"
  ],
  "properties": {
    "product_id": { "type": "string", "minLength": 1 },
    "price_range": { "$ref": "#/$defs/priceRange" },
    "competitor_matrix": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/competitorRow" }
    },
    "strengths": {
      "type": "array",
      "items": { "$ref": "#/$defs/analysisClaim" }
    },
    "weaknesses": {
      "type": "array",
      "items": { "$ref": "#/$defs/analysisClaim" }
    },
    "differentiation_opportunities": {
      "type": "array",
      "items": { "$ref": "#/$defs/opportunityClaim" }
    }
  },
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "priceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "minimum",
        "median",
        "maximum",
        "sample_size",
        "evidence_ids",
        "confidence",
        "source_type"
      ],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "minimum": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 },
        "sample_size": { "type": "integer", "minimum": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "confidence": { "const": 1 },
        "source_type": { "const": "calculated" }
      }
    },
    "competitorRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competitor_id",
        "name",
        "price",
        "currency",
        "rating",
        "review_count",
        "features",
        "selling_points",
        "evidence_ids",
        "confidence",
        "source_type"
      ],
      "properties": {
        "competitor_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "price": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "review_count": { "type": "integer", "minimum": 0 },
        "features": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "selling_points": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "confidence": { "const": 1 },
        "source_type": { "const": "data_fact" }
      }
    },
    "analysisClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "evidence_ids", "confidence", "source_type"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "source_type": { "const": "ai_inference" }
      }
    },
    "opportunityClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "title",
        "description",
        "evidence_ids",
        "confidence",
        "source_type"
      ],
      "properties": {
        "opportunity_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "source_type": { "const": "ai_inference" }
      }
    }
  }
}
